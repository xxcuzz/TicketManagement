@model Web.ViewModel.EditEventViewModel
@using TicketManagement.BusinessLogic.EntitiesDTO
@inject TicketManagement.BusinessLogic.Services.Interfaces.IService<LayoutDto> layoutService
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer

@{
    var layouts = layoutService.GetAll();
}

<div class="row">
    <div class="col">
        <form asp-action="Add" asp-controller="ManageEvents" asp-route-id="Model.Id" id="edit-event-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <input asp-for="Id" class="form-control" hidden />
            </div>
            <div class="form-group">
                <label>@localizer["Name"]</label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="form-group">
                <label>@localizer["Description"]</label>
                <input asp-for="Description" class="form-control" />
            </div>
            <div class="form-group">
                <label>@localizer["Layout"]</label>
                <select asp-for="LayoutId"
                        asp-items="@ViewBag.Layouts"
                        class="form-control">
                    <option>Please select one</option>
                </select>
            </div>
            <div class="form-group">
                <label>@localizer["Image"]</label>
                <input asp-for="Image" class="form-control" />
            </div>
            <div class="form-group">
                <label>@localizer["EventStart"]</label>
                <input asp-for="EventStart" type="date" />
                <input asp-for="EventStart" type="time" />
            </div>

            <div class="form-group">
                <label>@localizer["EventEnd"]</label>
                <input asp-for="EventEnd" type="date" />
                <input asp-for="EventEnd" type="time" />
            </div>

            <button id="update-profile-button" type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</div>