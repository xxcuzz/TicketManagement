@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model IEnumerable<Web.ViewModel.IndexViewModel>

@if (User.IsInRole("Event Manager"))
{
    <div style="display: inline">
    <a asp-controller="ManageEvents" asp-action="Add" class="btn btn-outline-success" style="vertical-align:top">@localizer["Create Event"]</a>

    <form id="importForm" method="post" enctype="multipart/form-data" style="display:inline" asp-controller="ThirdParty" asp-action="UploadEvents">
        <label for="importFile" class="btn btn-outline-secondary">@localizer["Import events"]</label>
        <div>
            <input type="file" id="importFile" name="jsonFile" style="display: none">
        </div>
    </form>
        </div>
}

<table class="table">
    <tr>
        <th>
            <label for="Event-Name">@localizer["Name"]</label>
        </th>
        <th>
            <label for="Event-Description">@localizer["Description"]</label>
        </th>
        <th>
            <label for="Ticket-Available">@localizer["TicketAvailable"]</label>
        </th>
        <th>
        </th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TicketAvailable)
            </td>

            <td>
                @if (User.IsInRole("Event Manager"))
                {
                    <a class="btn btn-warning" asp-controller="ManageEvents" asp-action="Edit" asp-route-id="@item.Id">@localizer["Edit"]</a>
                    <a class="btn btn-outline-danger" asp-controller="ManageEvents" asp-action="Delete" asp-route-id="@item.Id">×</a>
                }
                else
                {
                    <p><a class="btn btn-warning" asp-controller="Home" asp-action="EventView" asp-route-id="@item.Id">@localizer["Details"]</a></p>
                }
            </td>
        </tr>
    }
</table>

@section Scripts{
    <script>
        document.getElementById("importFile").onchange = function () {
            document.getElementById("importForm").submit();
        };
    </script>
}